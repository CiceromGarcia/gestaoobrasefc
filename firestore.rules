rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ==============================
       FUNÇÕES BÁSICAS
    ============================== */

    function estaLogado() {
      return request.auth != null;
    }

    function emailLogado() {
      return estaLogado() ? request.auth.token.email : "";
    }

    function ehAdministradorPorEmail() {
      return estaLogado()
        && emailLogado() in [
          "cicero.garcia@vale.com",
          "c0706341@vale.com",
          "ciceromgarcia@gmail.com"
        ];
    }

    function usuarioExiste() {
      return estaLogado()
        && exists(/databases/$(database)/documents/usuariosSistema/$(request.auth.uid));
    }

    function dadosUsuarioLogado() {
      return get(/databases/$(database)/documents/usuariosSistema/$(request.auth.uid)).data;
    }

    function usuarioAtivo() {
      return usuarioExiste()
        && dadosUsuarioLogado().status == "ativo";
    }

    function perfilUsuarioLogado() {
      return usuarioExiste()
        ? dadosUsuarioLogado().perfil
        : "";
    }

    function regionalUsuarioLogado() {
      return usuarioExiste()
        ? dadosUsuarioLogado().regional
        : "";
    }

    function podeAprovarRMUsuarioLogado() {
      return usuarioExiste()
        && dadosUsuarioLogado().podeAprovarRM == true;
    }

    function ehAdministrador() {
      return ehAdministradorPorEmail()
        || (
          usuarioAtivo()
          && perfilUsuarioLogado() in [
            "administrador",
            "admin",
            "adm"
          ]
        );
    }

    function ehAdministradorRegional() {
      return usuarioAtivo()
        && (
          perfilUsuarioLogado() in [
            "administradorRegional",
            "adminRegional",
            "aprovadorRM"
          ]
          || podeAprovarRMUsuarioLogado()
        );
    }

    function ehUsuarioSistema() {
      return usuarioAtivo()
        || ehAdministrador();
    }

    function ehEditorObras() {
      return ehAdministrador()
        || (
          usuarioAtivo()
          && perfilUsuarioLogado() in [
            "gestor",
            "planejador",
            "engenharia",
            "editor"
          ]
        );
    }

    function podeAprovarRegional(regionalRM) {
      return ehAdministrador()
        || (
          ehAdministradorRegional()
          && regionalUsuarioLogado() == regionalRM
        );
    }

    function donoDaRM(dados) {
      return estaLogado()
        && (
          dados.criadoPorUid == request.auth.uid
          || dados.criadoPor.uid == request.auth.uid
          || dados.criadoPorEmail == emailLogado()
          || dados.criadoPor.email == emailLogado()
        );
    }

    function camposDeAprovacaoRM() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "statusAprovacao",
        "aplicada",

        "aprovadoPorUid",
        "aprovadoPorEmail",
        "aprovadoPorNome",
        "aprovadoPorRegional",
        "aprovadoEm",

        "reprovadoPorUid",
        "reprovadoPorEmail",
        "reprovadoPorNome",
        "reprovadoPorRegional",
        "reprovadoEm",
        "motivoReprovacao",

        "decididoEm",

        "tempoAprovacaoMs",
        "tempoAprovacaoMinutos",
        "tempoAprovacaoHoras",
        "tempoAprovacaoTexto",

        "tempoDecisaoMs",
        "tempoDecisaoMinutos",
        "tempoDecisaoHoras",
        "tempoDecisaoTexto",

        "atualizadoEm"
      ]);
    }

    function rmEstaPendente() {
      return resource.data.statusAprovacao == "Pendente de Aprovação"
        || resource.data.status == "Pendente";
    }

    function decisaoValidaRM() {
      return request.resource.data.statusAprovacao in [
        "Aprovada",
        "Reprovada"
      ];
    }

    /* ==============================
       USUÁRIOS DO SISTEMA
    ============================== */

    match /usuariosSistema/{uid} {

      /*
        LEITURA:
        - Usuário logado pode ler o próprio cadastro.
        - Administrador pode ler todos.
      */
      allow read: if estaLogado()
        && (
          request.auth.uid == uid
          || ehAdministrador()
        );

      /*
        CRIAÇÃO:
        - Administrador pode criar usuários pelo painel.
        - Novo usuário pode criar apenas o próprio cadastro pendente.
      */
      allow create: if estaLogado()
        && (
          ehAdministrador()
          ||
          (
            request.auth.uid == uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.email == emailLogado()
            && request.resource.data.perfil == "usuario"
            && request.resource.data.status == "pendente"
            && request.resource.data.podeAprovarRM != true
          )
        );

      /*
        ATUALIZAÇÃO:
        - Administrador pode aprovar, inativar, alterar perfil, regional e permissão.
        - Usuário comum só pode atualizar o próprio cadastro sem mudar dados críticos.
      */
      allow update: if estaLogado()
        && (
          ehAdministrador()
          ||
          (
            request.auth.uid == uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.email == resource.data.email
            && request.resource.data.perfil == resource.data.perfil
            && request.resource.data.status == resource.data.status
            && request.resource.data.podeAprovarRM == resource.data.podeAprovarRM
            && request.resource.data.regional == resource.data.regional
          )
        );

      /*
        EXCLUSÃO:
        - Somente administrador.
      */
      allow delete: if ehAdministrador();
    }

    /* ==============================
       REQUISIÇÕES DE MATERIAIS
    ============================== */

    match /requisicoes_materiais/{rmId} {

      /*
        LEITURA:
        - Administrador geral lê tudo.
        - Administrador Regional lê RMs da própria Regional.
        - Usuário comum lê somente as próprias RMs.
      */
      allow get, list: if ehUsuarioSistema()
        && (
          ehAdministrador()
          || podeAprovarRegional(resource.data.regional)
          || donoDaRM(resource.data)
        );

      /*
        CRIAÇÃO:
        - Usuário ativo pode criar somente RM própria.
        - A RM deve nascer pendente.
      */
      allow create: if ehUsuarioSistema()
        && donoDaRM(request.resource.data)
        && request.resource.data.statusAprovacao == "Pendente de Aprovação"
        && request.resource.data.aplicada == false;

      /*
        ATUALIZAÇÃO:
        - Administrador geral pode ajustar a RM.
        - Administrador Regional só pode aprovar/reprovar RM da própria Regional.
        - Usuário comum não altera aprovação.
      */
      allow update: if ehUsuarioSistema()
        && (
          ehAdministrador()
          ||
          (
            podeAprovarRegional(resource.data.regional)
            && rmEstaPendente()
            && decisaoValidaRM()
            && camposDeAprovacaoRM()
          )
        );

      /*
        EXCLUSÃO:
        - Somente administrador geral.
      */
      allow delete: if ehAdministrador();
    }

    /* ==============================
       OBRAS
    ============================== */

    match /obras/{obraId} {
      allow read: if ehUsuarioSistema();
      allow create: if ehEditorObras();
      allow update: if ehEditorObras();
      allow delete: if ehAdministrador();
    }

    /* ==============================
       PLANEJAMENTO CURVA S
    ============================== */

    match /planejamentoCurvaS/{planejamentoId} {
      allow read: if ehUsuarioSistema();
      allow create: if ehEditorObras();
      allow update: if ehEditorObras();
      allow delete: if ehAdministrador();
    }

    /* ==============================
       REALIZADO CURVA S
    ============================== */

    match /realizadoCurvaS/{realizadoId} {
      allow read: if ehUsuarioSistema();
      allow create: if ehEditorObras();
      allow update: if ehEditorObras();
      allow delete: if ehAdministrador();
    }

    /* ==============================
       ATUALIZAÇÕES DE PROJETOS
    ============================== */

    match /projetos_atualizados/{atualizacaoId} {
      allow read: if ehUsuarioSistema();
      allow create: if ehEditorObras();
      allow update: if ehEditorObras();
      allow delete: if ehAdministrador();
    }

    /* ==============================
       PROJETOS
    ============================== */

    match /projetos/{projetoId} {
      allow read: if ehUsuarioSistema();
      allow create: if ehEditorObras();
      allow update: if ehEditorObras();
      allow delete: if ehAdministrador();
    }

    /* ==============================
       CRONOGRAMA SEMANAL
    ============================== */

    match /projetos/{projetoId}/cronogramaSemanal/{semanaId} {
      allow read: if ehUsuarioSistema();
      allow create: if ehEditorObras();
      allow update: if ehEditorObras();
      allow delete: if ehAdministrador();
    }

    match /cronogramaSemanal/{semanaId} {
      allow read: if ehUsuarioSistema();
      allow create: if ehEditorObras();
      allow update: if ehEditorObras();
      allow delete: if ehAdministrador();
    }

    /* ==============================
       CONTADORES
    ============================== */

    match /contador/{contadorId} {
      allow read: if ehUsuarioSistema();
      allow create: if ehEditorObras();
      allow update: if ehEditorObras();
      allow delete: if ehAdministrador();
    }

    /* ==============================
       CUSTOS / ANOMALIAS
    ============================== */

    match /custos/{id} {
      allow read: if ehUsuarioSistema();
      allow create: if ehEditorObras();
      allow update: if ehEditorObras();
      allow delete: if ehAdministrador();
    }

    match /anomalias/{id} {
      allow read: if ehUsuarioSistema();
      allow create: if ehEditorObras();
      allow update: if ehEditorObras();
      allow delete: if ehAdministrador();
    }

    /* ==============================
       ROLLUPS POR PROJETO
    ============================== */

    match /projetos/{projetoId}/rollups/{rollupId} {
      allow read: if ehUsuarioSistema();
      allow write: if ehAdministrador();
    }

    /* ==============================
       INDICADORES / ROLLUPS GERAIS
    ============================== */

    match /rollupsIndicadores/{id} {
      allow read: if ehUsuarioSistema();
      allow write: if ehAdministrador();
    }

    match /indicadoresObra_snapshot/{id} {
      allow read: if ehUsuarioSistema();
      allow write: if ehAdministrador();
    }

    match /indicadoresObra_semanal/{id} {
      allow read: if ehUsuarioSistema();
      allow write: if ehAdministrador();
    }

    match /indicadoresObra_mensal/{id} {
      allow read: if ehUsuarioSistema();
      allow write: if ehAdministrador();
    }

    /* ==============================
       PESQUISAS DE OBRAS
    ============================== */

    match /pesquisasObras/{id} {
      allow read: if ehUsuarioSistema();
      allow create: if ehUsuarioSistema();
      allow update: if ehAdministrador();
      allow delete: if ehAdministrador();
    }

    /* ==============================
       BLOQUEIO FINAL
    ============================== */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}