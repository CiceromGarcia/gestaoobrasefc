rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ==============================
       FUNÇÕES BÁSICAS
    ============================== */

    function estaLogado() {
      return request.auth != null;
    }

    function emailLogado() {
      return estaLogado() ? request.auth.token.email : "";
    }

    function usuarioExiste() {
      return estaLogado()
        && exists(/databases/$(database)/documents/usuariosSistema/$(request.auth.uid));
    }

    function dadosUsuarioLogado() {
      return get(/databases/$(database)/documents/usuariosSistema/$(request.auth.uid)).data;
    }

    function perfilUsuarioLogado() {
      return usuarioExiste()
        ? dadosUsuarioLogado().perfil
        : "";
    }

    function statusUsuarioLogado() {
      return usuarioExiste()
        ? dadosUsuarioLogado().status
        : "";
    }

    function regionalUsuarioLogado() {
      return usuarioExiste()
        ? dadosUsuarioLogado().regional
        : "";
    }

    function perfilValido(perfil) {
      return perfil in [
        "administrador",
        "planejador",
        "usuario"
      ];
    }

    function statusValido(status) {
      return status in [
        "ativo",
        "pendente",
        "inativo"
      ];
    }

    function usuarioAtivo() {
      return usuarioExiste()
        && statusUsuarioLogado() == "ativo"
        && perfilValido(perfilUsuarioLogado());
    }

    function ehAdministradorGeral() {
      return usuarioAtivo()
        && perfilUsuarioLogado() == "administrador";
    }

    function ehPlanejador() {
      return usuarioAtivo()
        && perfilUsuarioLogado() == "planejador";
    }

    function ehUsuarioComum() {
      return usuarioAtivo()
        && perfilUsuarioLogado() == "usuario";
    }

    function ehUsuarioSistema() {
      return usuarioAtivo();
    }

    function podeCriarObra() {
      return ehAdministradorGeral()
        || ehPlanejador();
    }

    function podeEditarObraProgramada() {
      return ehAdministradorGeral();
    }

    function podeExcluirObraProgramada() {
      return ehAdministradorGeral();
    }

    function podeAprovarRM() {
      return ehAdministradorGeral();
    }

    function usuarioSistemaValido(dados) {
      return dados.keys().hasAll([
        "email",
        "perfil",
        "status"
      ])
      && dados.email is string
      && dados.perfil is string
      && dados.status is string
      && perfilValido(dados.perfil)
      && statusValido(dados.status);
    }

    function atualizacaoSeguraDoProprioUsuario() {
      return request.auth.uid == resource.data.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.perfil == resource.data.perfil
        && request.resource.data.status == resource.data.status
        && request.resource.data.regional == resource.data.regional
        && request.resource.data.podeAprovarRM == resource.data.podeAprovarRM
        && request.resource.data.adminRebaixado == resource.data.adminRebaixado;
    }

    /* ==============================
       FUNÇÕES RM
    ============================== */

    function donoDaRM(dados) {
      return estaLogado()
        && (
          (
            dados.keys().hasAny(["criadoPorUid"])
            && dados.criadoPorUid == request.auth.uid
          )
          ||
          (
            dados.keys().hasAny(["criadoPorEmail"])
            && dados.criadoPorEmail == emailLogado()
          )
          ||
          (
            dados.keys().hasAny(["criadoPor"])
            && dados.criadoPor is map
            && (
              (
                dados.criadoPor.keys().hasAny(["uid"])
                && dados.criadoPor.uid == request.auth.uid
              )
              ||
              (
                dados.criadoPor.keys().hasAny(["email"])
                && dados.criadoPor.email == emailLogado()
              )
            )
          )
        );
    }

    function contratoValidoRM() {
      return request.resource.data.keys().hasAny(["contrato"])
        && request.resource.data.contrato is string
        && request.resource.data.contrato in [
          "Manutenção Predial",
          "Pequenas Obras"
        ];
    }

    function criacaoValidaRM() {
      return request.resource.data.keys().hasAll([
          "numeroRM",
          "numeroOM",
          "titulo",
          "contrato",
          "regional",
          "localidade",
          "statusAprovacao",
          "aplicada",
          "materiais",
          "criadoPorUid",
          "criadoPorEmail"
        ])
        && request.resource.data.statusAprovacao == "Pendente de Aprovação"
        && request.resource.data.aplicada == false
        && request.resource.data.materiais is list
        && contratoValidoRM()
        && donoDaRM(request.resource.data);
    }

    function camposDeAprovacaoRM() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "statusAprovacao",
        "aplicada",

        "aprovadoPorUid",
        "aprovadoPorEmail",
        "aprovadoPorNome",
        "aprovadoPorRegional",
        "aprovadoEm",

        "reprovadoPorUid",
        "reprovadoPorEmail",
        "reprovadoPorNome",
        "reprovadoPorRegional",
        "reprovadoEm",
        "motivoReprovacao",

        "decididoEm",

        "tempoAprovacaoMs",
        "tempoAprovacaoMinutos",
        "tempoAprovacaoHoras",
        "tempoAprovacaoTexto",

        "tempoDecisaoMs",
        "tempoDecisaoMinutos",
        "tempoDecisaoHoras",
        "tempoDecisaoTexto",

        "atualizadoEm"
      ]);
    }

    function rmEstaPendente() {
      return resource.data.statusAprovacao == "Pendente de Aprovação"
        || resource.data.status == "Pendente";
    }

    function decisaoValidaRM() {
      return request.resource.data.statusAprovacao in [
        "Aprovada",
        "Reprovada"
      ];
    }

    /* ==============================
       FUNÇÕES PLANEJAMENTO CURVA S
    ============================== */

    function criacaoValidaPlanejamentoCurvaS() {
      return podeCriarObra()
        && request.resource.data.keys().hasAll([
          "obra",
          "obraNome",
          "obraId",
          "semana",
          "semanaNumero",
          "fisico",
          "fisicoAcum",
          "financeiro",
          "financeiroAcum",
          "ativo",
          "criadoPorUid",
          "criadoPorEmail"
        ])
        && request.resource.data.ativo == true
        && request.resource.data.criadoPorUid == request.auth.uid
        && request.resource.data.criadoPorEmail == emailLogado();
    }

    /* ==============================
       USUÁRIOS DO SISTEMA
    ============================== */

    match /usuariosSistema/{uid} {

      allow get: if estaLogado()
        && (
          request.auth.uid == uid
          || ehAdministradorGeral()
        );

      allow list: if estaLogado()
        && (
          ehAdministradorGeral()
          || resource.data.uid == request.auth.uid
          || resource.data.email == emailLogado()
          || resource.data.emailAuth == emailLogado()
          || resource.data.usuarioEmail == emailLogado()
          || resource.data.login == emailLogado()
        );

      allow create: if estaLogado()
        && (
          (
            ehAdministradorGeral()
            && usuarioSistemaValido(request.resource.data)
          )
          ||
          (
            request.auth.uid == uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.email == emailLogado()
            && request.resource.data.perfil == "usuario"
            && request.resource.data.status == "pendente"
            && (
              !request.resource.data.keys().hasAny(["podeAprovarRM"])
              || request.resource.data.podeAprovarRM == false
            )
          )
        );

      allow update: if estaLogado()
        && (
          (
            ehAdministradorGeral()
            && usuarioSistemaValido(request.resource.data)
          )
          ||
          atualizacaoSeguraDoProprioUsuario()
        );

      allow delete: if ehAdministradorGeral();
    }

    /* ==============================
       REQUISIÇÕES DE MATERIAIS
    ============================== */

    match /requisicoes_materiais/{rmId} {

      allow get: if ehUsuarioSistema()
        && (
          ehAdministradorGeral()
          || donoDaRM(resource.data)
        );

      allow list: if ehUsuarioSistema()
        && (
          ehAdministradorGeral()
          || donoDaRM(resource.data)
        );

      allow create: if ehUsuarioSistema()
        && criacaoValidaRM();

      allow update: if ehUsuarioSistema()
        && (
          ehAdministradorGeral()
          ||
          (
            podeAprovarRM()
            && rmEstaPendente()
            && decisaoValidaRM()
            && camposDeAprovacaoRM()
          )
        );

      allow delete: if ehAdministradorGeral();
    }

    /* ==============================
       OBRAS
    ============================== */

    match /obras/{obraId} {
      allow read: if ehUsuarioSistema();

      allow create: if podeCriarObra();

      allow update: if podeEditarObraProgramada();

      allow delete: if podeExcluirObraProgramada();
    }

    /* ==============================
       PROJETOS
    ============================== */

    match /projetos/{projetoId} {
      allow read: if ehUsuarioSistema();

      allow create: if podeCriarObra();

      allow update: if podeEditarObraProgramada();

      allow delete: if podeExcluirObraProgramada();
    }

    /* ==============================
       SUBCOLEÇÕES DOS PROJETOS
    ============================== */

    match /projetos/{projetoId}/cronogramaSemanal/{semanaId} {
      allow read: if ehUsuarioSistema();

      allow create: if podeCriarObra();

      allow update: if podeEditarObraProgramada();

      allow delete: if podeExcluirObraProgramada();
    }

    match /projetos/{projetoId}/rollups/{rollupId} {
      allow read: if ehUsuarioSistema();

      allow create: if podeEditarObraProgramada();

      allow update: if podeEditarObraProgramada();

      allow delete: if podeExcluirObraProgramada();
    }

    /* ==============================
       PLANEJAMENTO CURVA S
    ============================== */

    match /planejamentoCurvaS/{planejamentoId} {
      allow read: if ehUsuarioSistema();

      allow create: if criacaoValidaPlanejamentoCurvaS();

      allow update: if podeEditarObraProgramada();

      allow delete: if podeExcluirObraProgramada();
    }

    /* ==============================
       REALIZADO CURVA S
    ============================== */

    match /realizadoCurvaS/{realizadoId} {
      allow read: if ehUsuarioSistema();

      allow create: if podeCriarObra();

      allow update: if podeEditarObraProgramada();

      allow delete: if podeExcluirObraProgramada();
    }

    /* ==============================
       ATUALIZAÇÕES DE PROJETOS
    ============================== */

    match /projetos_atualizados/{atualizacaoId} {
      allow read: if ehUsuarioSistema();

      allow create: if podeCriarObra();

      allow update: if podeEditarObraProgramada();

      allow delete: if podeExcluirObraProgramada();
    }

    /* ==============================
       CRONOGRAMA SEMANAL
    ============================== */

    match /cronogramaSemanal/{semanaId} {
      allow read: if ehUsuarioSistema();

      allow create: if podeCriarObra();

      allow update: if podeEditarObraProgramada();

      allow delete: if podeExcluirObraProgramada();
    }

    /* ==============================
       CONTADORES
    ============================== */

    match /contador/{contadorId} {
      allow read: if ehUsuarioSistema();

      allow create: if podeCriarObra();

      allow update: if podeEditarObraProgramada();

      allow delete: if podeExcluirObraProgramada();
    }

    /* ==============================
       CUSTOS
    ============================== */

    match /custos/{id} {
      allow read: if ehUsuarioSistema();

      allow create: if podeCriarObra();

      allow update: if podeEditarObraProgramada();

      allow delete: if podeExcluirObraProgramada();
    }

    /* ==============================
       ANOMALIAS
    ============================== */

    match /anomalias/{id} {
      allow read: if ehUsuarioSistema();

      allow create: if podeCriarObra();

      allow update: if podeEditarObraProgramada();

      allow delete: if podeExcluirObraProgramada();
    }

    /* ==============================
       INDICADORES / ROLLUPS GERAIS
    ============================== */

    match /rollupsIndicadores/{id} {
      allow read: if ehUsuarioSistema();

      allow create: if podeEditarObraProgramada();

      allow update: if podeEditarObraProgramada();

      allow delete: if podeExcluirObraProgramada();
    }

    match /indicadoresObra_snapshot/{id} {
      allow read: if ehUsuarioSistema();

      allow create: if podeEditarObraProgramada();

      allow update: if podeEditarObraProgramada();

      allow delete: if podeExcluirObraProgramada();
    }

    match /indicadoresObra_semanal/{id} {
      allow read: if ehUsuarioSistema();

      allow create: if podeEditarObraProgramada();

      allow update: if podeEditarObraProgramada();

      allow delete: if podeExcluirObraProgramada();
    }

    match /indicadoresObra_mensal/{id} {
      allow read: if ehUsuarioSistema();

      allow create: if podeEditarObraProgramada();

      allow update: if podeEditarObraProgramada();

      allow delete: if podeExcluirObraProgramada();
    }

    /* ==============================
       PESQUISAS DE OBRAS
    ============================== */

    match /pesquisasObras/{id} {
      allow read: if ehUsuarioSistema();

      allow create: if ehUsuarioSistema();

      allow update: if podeEditarObraProgramada();

      allow delete: if podeExcluirObraProgramada();
    }

    match /pesquisasRespostas/{id} {
      allow read: if ehAdministradorGeral();

      allow create: if ehUsuarioSistema();

      allow update: if ehAdministradorGeral();

      allow delete: if ehAdministradorGeral();
    }

    /* ==============================
       AUDITORIA / HISTÓRICO DE EXCLUSÃO
    ============================== */

    match /historicoExclusoesObras/{id} {
      allow read: if ehAdministradorGeral();

      allow create: if ehAdministradorGeral();

      allow update: if ehAdministradorGeral();

      allow delete: if ehAdministradorGeral();
    }

    match /auditoriaExclusoesObras/{id} {
      allow read: if ehAdministradorGeral();

      allow create: if ehAdministradorGeral();

      allow update: if ehAdministradorGeral();

      allow delete: if ehAdministradorGeral();
    }

    /* ==============================
       BLOQUEIO FINAL
    ============================== */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}