# =====================================================
# CONFIGURAÇÃO DE SMTP (envio de e-mails pelas Cloud Functions)
#
# Como usar:
# 1. Copie este arquivo para ".env" (mesma pasta functions/).
# 2. Preencha os valores reais abaixo, direto aqui no editor
#    (nunca cole senha no chat/console do navegador).
# 3. Rode: firebase deploy --only functions
#    (o arquivo .env é lido pelo Firebase CLI na hora do deploy
#    e vira variável de ambiente das Cloud Functions).
#
# O arquivo ".env" já está no .gitignore (functions/.gitignore),
# então não corre risco de subir pro Git por engano.
# ESTE arquivo (.env.example) NÃO tem esse gitignore de propósito —
# é o modelo público, então NUNCA preencha valores reais aqui.
# =====================================================

# Servidor SMTP (ex.: smtp.gmail.com, smtp.office365.com, etc.)
SMTP_HOST=

# Porta do SMTP (587 = STARTTLS, 465 = SSL direto)
SMTP_PORT=587

# "true" só se a porta for 465 (SSL direto). Para 587, deixe "false".
SMTP_SECURE=false

# E-mail que vai aparecer como remetente e que faz login no SMTP
SMTP_USER=

# Senha do e-mail acima.
# Gmail/Google Workspace: NÃO é a senha normal da conta — precisa
# gerar uma "Senha de app" em myaccount.google.com/apppasswords
# (exige verificação em 2 etapas ativada).
# Outlook/Office365: normalmente é a senha normal, ou uma senha de
# app se a organização exigir MFA.
SMTP_PASS=

# URL base usada nos links de pesquisa de satisfação enviados por e-mail
APP_URL=https://SEU-HOST/pesquisa.html

# Token de proteção do endpoint backfillRollups (gere uma string
# aleatória longa, ex.: com `openssl rand -hex 32`)
ROLLUP_TOKEN=

# Lista de e-mails do resumo semanal de obras em andamento (opcional
# — se deixar vazio, usa a lista padrão já configurada no código)
RESUMO_OBRAS_ANDAMENTO_EMAILS=
